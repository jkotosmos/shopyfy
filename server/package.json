{
  "name": "shopyfy-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shopify OAuth + Admin API backend scaffold for Shopyfy — connects a seller's Shopify account and publishes a generated store as a real product listing.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
