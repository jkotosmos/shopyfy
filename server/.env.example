# Copy to .env and fill in real values. Never commit .env.
#
# Get SHOPIFY_API_KEY / SHOPIFY_API_SECRET by creating an app in the Shopify
# Partner Dashboard (partners.shopify.com -> Apps -> Create app). Use a
# "Custom app" for a single store, or a "Public app" if you'll connect
# multiple sellers' stores. Set the app's redirect URL to
# {HOST}/auth/callback — must match HOST below exactly.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=write_products,read_products,write_price_rules,write_discounts
SHOPIFY_API_VERSION=2025-01

# Public HTTPS URL this server is reachable at (Shopify redirects here after
# a merchant approves install). For local development, use a tunnel — see
# server/README.md — since Shopify will not redirect to http://localhost.
HOST=https://your-backend.example.com

# Where the frontend (Shopyfy Vite app) is served from, for CORS and for the
# post-install redirect back into the app.
APP_URL=http://localhost:5173

# Random long string used to sign the short-lived OAuth session token AND
# the longer-lived purchase entitlement token. Generate with:
# openssl rand -hex 32
SESSION_SECRET=

PORT=8787

# Where the demo JSON token/promo-code store writes its files. Replace
# tokenStore.ts / promoStore.ts with a real database before production —
# see README.
DATA_DIR=./data

# --- Payments (optional) ---------------------------------------------------
# Without these, the Shopify OAuth/publish routes above still work; only
# /api/checkout, /api/webhooks/stripe, and /api/promo/redeem are disabled.
#
# Get STRIPE_SECRET_KEY from dashboard.stripe.com -> Developers -> API keys
# (use a *test* key while building this). Money from real payments goes
# straight to whichever Stripe account owns this key — this backend never
# touches card details itself, Stripe Checkout collects payment on
# Stripe's own hosted page.
STRIPE_SECRET_KEY=

# Create one-time Prices in the Stripe Dashboard (Product catalog -> your
# product -> Add a price -> one-time), one per plan, and paste their
# price_... IDs here. Leave a plan blank to disable checkout for it.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# From `stripe listen --forward-to localhost:8787/api/webhooks/stripe`
# locally (it prints a whsec_... value), or from the webhook endpoint's
# settings page in the Stripe Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=

# --- Outbound email for promo codes (optional) ------------------------------
# Any SMTP provider works (Gmail, SendGrid, Postmark, AWS SES, Resend's SMTP
# endpoint, etc.) — this isn't tied to one vendor's API. Without these set,
# promo codes are still generated and stored after a successful payment,
# just not emailed (check the server log for the code during testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shopyfy <no-reply@yourdomain.com>"

# --- Real market data (optional) --------------------------------------------
# Powers GET /api/market-data?q=<keyword> — real Google-Trends-style
# interest/region data, real eBay listings, real ads. Each source is
# independent: configure any subset and the endpoint reports the rest as
# null (the frontend falls back to its illustrative demo generators
# per-source). See server/README.md for full setup notes and caveats.

# Google Trends has no publicly-available official API (only an invite-only
# alpha as of 2025), so this goes through SerpApi's Google Trends endpoint —
# serpapi.com, free trial credits then paid. Swap serpapiClient.ts for a
# different provider if you'd rather not use SerpApi.
SERPAPI_KEY=

# Free eBay developer account at developer.ebay.com -> create a keyset ->
# use the Client ID / Client Secret from the *production* keyset (the
# Browse API needs live data, not sandbox).
EBAY_APP_ID=
EBAY_CERT_ID=

# A Meta developer app (developers.facebook.com -> Create App). The App ID
# + App Secret are used as a combined app access token, which works for
# basic Ad Library keyword search on non-political/non-issue ads. Search
# volume beyond the basic tier, or political/social-issue ads, needs Meta's
# separate Ad Library API access review — see server/README.md.
META_ADS_APP_ID=
META_ADS_APP_SECRET=
